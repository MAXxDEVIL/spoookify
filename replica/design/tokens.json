{
  "name": "Spoookify",
  "colors": {
    "background": {
      "primary": "#0f0f23",
      "secondary": "#1a1a2e",
      "elevated": "#16213e",
      "surface": "#0e346a"
    },
    "text": {
      "primary": "#ffffff",
      "secondary": "#b3b3b3",
      "tertiary": "#6b6b6b"
    },
    "accent": {
      "primary": "#4f46e5",
      "hover": "#6366f1",
      "active": "#4338ca"
    },
    "status": {
      "success": "#10b981",
      "error": "#ef4444",
      "warning": "#f59e0b"
    },
    "border": "#2a2a3e"
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem"
  },
  "borderRadius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.5)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.5)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.5)"
  }
